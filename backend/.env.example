# Project Pulse — Backend environment files (reference)
#
# The backend loads the right file based on NODE_ENV (set automatically by
# the npm scripts):
#
#   npm run dev   →  NODE_ENV=development  → .env.development(.local)
#   npm start     →  NODE_ENV=production   → .env.production(.local)
#
# Files committed to git:
#   .env.development  — safe defaults for `npm run dev`
#   .env.production   — fill in when deploying (currently empty)
#
# Files gitignored — put secrets here:
#   .env.development.local  — your local Postgres user, Anthropic key, etc.
#   .env.production.local   — production secrets
#
# `.local` files override the committed ones (same name = `.local` wins).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=project_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis (currently optional) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Anthropic (required for AI alerts + Project Intelligence) ───────────────
# Get a key at https://console.anthropic.com/
# Put the real value in `.env.development.local`, NOT here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
