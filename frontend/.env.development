# Loaded automatically by Vite when running `npm run dev`.
# Committed to git — must contain non-secret defaults only.
# Override personal values (ngrok URL etc.) in `.env.development.local`.

# Internal API calls — the backend running on your machine.
VITE_API_URL=http://localhost:3001

# Public webhook URLs shown to users. Set this in `.env.development.local`
# to your current ngrok tunnel URL — it changes every time ngrok restarts.
VITE_BACKEND_URL=
