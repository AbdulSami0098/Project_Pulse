# Project Pulse — Frontend environment files (reference)
#
# Vite automatically loads the right file based on the command you run:
#
#   npm run dev   →  .env.development  (+ .env.development.local override)
#   npm run build →  .env.production   (+ .env.production.local  override)
#
# Files committed to git:
#   .env.development  — safe defaults for `npm run dev`
#   .env.production   — fill in when deploying (currently empty)
#
# Files gitignored — put personal values + secrets here:
#   .env.development.local  — your ngrok URL etc.
#   .env.production.local   — production secrets if needed
#
# ─── Dual-URL design ─────────────────────────────────────────────────────────
# VITE_API_URL     — internal API + Socket.io calls (browser → backend).
#                    DEV:  http://localhost:3001
#                    PROD: your deployed backend URL
#
# VITE_BACKEND_URL — public webhook URLs shown to USERS in the Settings UI.
#                    External services (GitHub, Jira, Slack, Teams) call this.
#                    DEV:  an ngrok tunnel to localhost:3001
#                    PROD: usually the same host as VITE_API_URL
#
# In production these two values are typically identical. The split only
# matters in local dev, where the browser hits localhost but webhooks must
# traverse a public tunnel.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3001
VITE_BACKEND_URL=
