# Loaded automatically by Vite when running `npm run build`.
# Committed to git — fill these in before your first production deploy.

# Deployed backend URL — used for API and Socket.io.
# TODO: Set this when deploying.
VITE_API_URL=

# Public webhook URL — usually identical to VITE_API_URL in production.
# TODO: Set this when deploying.
VITE_BACKEND_URL=
